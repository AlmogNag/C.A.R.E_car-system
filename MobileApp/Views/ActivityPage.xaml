<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:CARE_App_Mobile"
             x:Class="CARE_App_Mobile.Views.ActivityPage"
             BackgroundColor="#080C1C"
             Title="Activity &amp; Logs">

    <Grid RowDefinitions="Auto,*" Padding="15" RowSpacing="15">

        <!-- Selected Preview Card -->
        <Border Grid.Row="0" BackgroundColor="#101730" Stroke="#1E293B" StrokeShape="RoundRectangle 14" Padding="15">
            <VerticalStackLayout Spacing="10">
                <Label Text="EVENT PREVIEW" TextColor="#FF7070" FontSize="12" FontAttributes="Bold" />
                <Border BackgroundColor="Black" StrokeShape="RoundRectangle 8" HeightRequest="200">
                    <Image x:Name="imgPreview" Aspect="AspectFit" />
                </Border>
                <Label x:Name="lblSelectedDetails" Text="Select an event below to preview capture" TextColor="#94A3B8" FontSize="13" />
            </VerticalStackLayout>
        </Border>

        <!-- Events Collection -->
        <CollectionView Grid.Row="1" x:Name="cvAlerts" SelectionMode="Single" SelectionChanged="OnAlertSelected">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:AlertRecord">
                    <Border BackgroundColor="#101730" Stroke="#1E293B" StrokeShape="RoundRectangle 12" Padding="12" Margin="0,4">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Label Grid.Column="0" Text="⚠️" FontSize="20" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="{Binding Timestamp}" TextColor="#F5F7FA" FontSize="14" FontAttributes="Bold" />
                                <Label Text="{Binding AlertSource, StringFormat='Source: {0}'}" TextColor="#94A3B8" FontSize="12" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="View" TextColor="#3B82F6" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>